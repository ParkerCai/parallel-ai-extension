{
  "name": "parallel-ai-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.2",
  "scripts": {
    "dev": "vite",
    "build": "bun scripts/prebuild-clean.mjs && vite build && bun scripts/stamp-version.mjs && bun scripts/check-shippable.mjs",
    "zip": "bun scripts/zip-dist.mjs",
    "package": "bun run build && bun run zip",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:live": "cross-env E2E_MODE=live playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "test:all": "vitest run && playwright test"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.1.40",
    "@types/react": "18",
    "@types/react-dom": "18",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.7",
    "cross-env": "^10.1.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.9.0",
    "playwright": "^1.60.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.9",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "lucide-react": "^1.8.0",
    "react": "18",
    "react-dom": "18",
    "react-resizable-panels": "^4.10.0"
  }
}
